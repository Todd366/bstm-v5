# Copy to your host's environment settings (Vercel -> Settings -> Environment Variables).
# Never commit real values.
BSTM_ENVIRONMENT=production
BSTM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres   # Supabase session pooler, port 5432
BSTM_DB_SCHEMA=activation
BSTM_JWT_SECRET=                      # 32+ random characters
BSTM_STAFF_KEY=                       # 24+ random characters; emergency admin key (BSTM_API_KEY still works as a fallback)
BSTM_PAY_INSTRUCTIONS="Orange Money 7xxxxxxx"
# Optional: BSTM_CORS_ORIGINS, BSTM_WEBHOOK_SECRET_<PROVIDER>, BSTM_RATE_*, BSTM_MAX_BODY_BYTES
